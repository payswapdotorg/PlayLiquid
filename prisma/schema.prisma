generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Creator {
  id        String    @id @default(cuid())
  handle    String    @unique
  name      String
  avatarUrl String
  verified  Boolean   @default(false)
  followers Int       @default(0)
  bio       String    @default("")
  isMe      Boolean   @default(false)
  createdAt DateTime  @default(now())
  games     Game[]
  sparks    Spark[]
}

model Game {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  description     String
  longDescription String        @default("")
  thumbnailUrl    String
  previewUrl      String
  engine          String
  themeJson       String        @default("{}")
  scenesJson      String        @default("{}")
  creatorId       String
  creator         Creator       @relation(fields: [creatorId], references: [id])
  category        String
  tags            String        @default("")
  plays           Int           @default(0)
  likes           Int           @default(0)
  rating          Float         @default(4.5)
  durationMin     Int           @default(5)
  isLive          Boolean       @default(false)
  isUpcoming      Boolean       @default(false)
  status          String        @default("published")
  version         String        @default("1.0.0")
  multiplayer     String        @default("")
  controllers     String        @default("Keyboard, Touch")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  comments        Comment[]
  sessions        PlaySession[]
  scores          Score[]
  sparks          Spark[]
  updates         GameUpdate[]
  tasks           Task[]
  savedBy         LibraryItem[]
}

model GameUpdate {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  version   String
  title     String
  body      String
  createdAt DateTime @default(now())
}

model Spark {
  id           String    @id @default(cuid())
  title        String
  caption      String    @default("")
  videoUrl     String
  thumbnailUrl String
  gameId       String?
  game         Game?     @relation(fields: [gameId], references: [id])
  creatorId    String
  creator      Creator   @relation(fields: [creatorId], references: [id])
  likes        Int       @default(0)
  plays        Int       @default(0)
  challenge    String?
  createdAt    DateTime  @default(now())
  comments     Comment[]
}

model Comment {
  id           String   @id @default(cuid())
  gameId       String?
  game         Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sparkId      String?
  spark        Spark?   @relation(fields: [sparkId], references: [id], onDelete: Cascade)
  authorName   String
  authorAvatar String   @default("")
  body         String
  likes        Int      @default(0)
  createdAt    DateTime @default(now())
}

model PlaySession {
  id         String   @id @default(cuid())
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  progress   Float    @default(0)
  lastScore  Int      @default(0)
  startedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Score {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player    String
  avatar    String   @default("")
  score     Int
  createdAt DateTime @default(now())
}

model Task {
  id         String   @id @default(cuid())
  prompt     String
  model      String   @default("GLM-4.6")
  mode       String   @default("Create")
  agent      String   @default("Game Architect")
  status     String   @default("completed")
  gameId     String?
  game       Game?    @relation(fields: [gameId], references: [id])
  resultJson String   @default("{}")
  createdAt  DateTime @default(now())
}

/** Saved-to-Library entries (server-side library persistence). */
model LibraryItem {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([gameId])
}

/** Scheduled / recurring desk tasks (Automations). */
model Automation {
  id        String    @id @default(cuid())
  name      String
  prompt    String
  schedule  String
  enabled   Boolean   @default(true)
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
}

/** Generic key-value preferences (settings, plugin states, notification opt-ins). */
model Preference {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
