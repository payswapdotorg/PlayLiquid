{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "composite": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "lib": ["es2024"]
  },
  "include": ["src/**/*.ts"]
}
